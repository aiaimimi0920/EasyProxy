{
  "schemaVersion": 1,
  "project": "EasyProxy",
  "releaseClass": "complex-multi-surface",
  "workflows": [
    {
      "component": "service-and-workers",
      "requiresImportCode": false,
      "releaseTagOutputs": [
        "release_tag",
        "version"
      ],
      "artifacts": [],
      "releaseTagInputs": [
        "release_tag"
      ],
      "requiresR2": false,
      "path": ".github/workflows/publish-ghcr-images.yml",
      "requiresGhcr": true
    },
    {
      "component": "native-release",
      "requiresImportCode": false,
      "releaseTagOutputs": [
        "release_tag",
        "version"
      ],
      "artifacts": [
        "github-release-native-assets"
      ],
      "releaseTagInputs": [
        "release_tag"
      ],
      "requiresR2": false,
      "path": ".github/workflows/publish-github-release.yml",
      "requiresGhcr": false,
      "nativeTargets": [
        "linux-amd64",
        "linux-arm64",
        "windows-amd64"
      ],
      "unsupportedTargets": [
        "windows-arm64"
      ],
      "releaseFiles": [
        "easyproxy-linux-amd64.tar.gz",
        "easyproxy-linux-arm64.tar.gz",
        "easyproxy-windows-amd64.zip",
        "easyproxyctl-linux-amd64.tar.gz",
        "easyproxyctl-linux-arm64.tar.gz",
        "easyproxyctl-windows-amd64.zip",
        "SHA256SUMS",
        "release-manifest.json"
      ],
      "requiresAttestation": true
    }
  ],
  "localDeploy": {
    "entrypoint": "deploy-host.ps1",
    "zeroFolder": true,
    "forbidDevSourceBindMounts": true
  },
  "exceptions": [
    "Multi-image publishing, Cloudflare deploy, and aggregator deploy stay project-specific.",
    "Runtime configuration is persistent local state and is not bundled into GHCR publication."
  ]
}
